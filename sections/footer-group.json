        "faq_item_DnpJ3G": {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We accept returns within 30 days of purchase.</p>"
          }
        },
        "faq_item_Gtwgm6": {
          "type": "faq_item",
          "settings": {
            "question": "How quickly do you respond to quote requests?",
            "answer": "<p>Quotes are returned the same day. The maximum turnaround is 24 hours.</p>"
          }
        },
        "faq_item_nJWEKY": {
          "type": "faq_item",
          "settings": {
            "question": "How long have UK Lab Chairs been supplying laboratory seating?",
            "answer": "<p>UK Lab Chairs is a sub-brand of Mark Finn Lab Furniture, established in 1986. We have over 40 years' experience supplying laboratory chairs, stools and technical seating to UK schools, universities, NHS trusts, pharma and biotech firms, and engineering companies.</p>"
          }
        },
        "faq_item_yV9YXX": {
          "type": "faq_item",
          "settings": {
            "question": "Who are your customers?",
            "answer": "<p>Our customers include the University of Oxford, McLaren F1, Moderna, Bristol Myers Squibb, Guy's & St Thomas' NHS Foundation Trust, Dyson and Mitsubishi, alongside hundreds of UK schools, colleges, universities and industrial laboratories.</p>"
          }
        },
        "faq_item_nntxKr": {
          "type": "faq_item",
          "settings": {
            "question": "Do you accept purchase orders?",
            "answer": "<p>Yes. Purchase orders are accepted from schools, colleges, universities, NHS trusts, government organisations and registered businesses. A VAT invoice is supplied. Our trading name on finance systems is Mark Finn Lab Furniture (or Lab Tables), in case procurement teams need to match records.</p>"
          }
        },
        "faq_item_EETFnR": {
          "type": "faq_item",
          "settings": {
            "question": "Can I order a small quantity, or do I need to buy in bulk?",
            "answer": "<p>Any quantity. Orders range from a single replacement chair to full laboratory seating supply.</p>"
          }
        },
        "faq_item_iRDKWb": {
          "type": "faq_item",
          "settings": {
            "question": "What guarantee do the chairs come with?",
            "answer": "<p>Every chair comes with a 5-year guarantee against normal wear and tear, from the date of delivery, when used under normal conditions and during a conventional working day.</p>"
          }
        },
        "faq_item_jKPkme": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between a lab chair and a draughtsman chair?",
            "answer": "<p>A standard lab chair is designed for seated or bench-height work, with a seat height that adjusts roughly 400–835 mm depending on model. A draughtsman chair is a high chair with an extended gas lift and footring, designed for use at tall standing benches or drawing boards. Both are available upholstered, in PU, or with anti-static (ESD) specification.</p>"
          }
        }
