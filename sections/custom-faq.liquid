{%- assign ai_gen_id = section.id | replace: '_', '' | downcase -%}

<section id="custom-faq-{{ ai_gen_id }}" class="custom-faq-{{ ai_gen_id }} section-padding color-{{ section.settings.color_scheme }}">
  <style>
    .custom-faq-{{ ai_gen_id }} {
      max-width: var(--page-width, 1200px);
      margin: 0 auto;
      padding: 40px 20px;
    }
    .custom-faq-{{ ai_gen_id }} .faq-title {
      text-align: center;
      margin-bottom: 30px;
      font-size: 2rem;
      color: rgb(var(--color-foreground));
    }
    .custom-faq-{{ ai_gen_id }} details {
      border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
      padding: 16px 0;
    }
    .custom-faq-{{ ai_gen_id }} summary {
      cursor: pointer;
      font-weight: 600;
      font-size: 1.05rem;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: rgb(var(--color-foreground));
    }
    .custom-faq-{{ ai_gen_id }} summary::-webkit-details-marker { display: none; }
    .custom-faq-{{ ai_gen_id }} summary::after {
      content: '+';
      font-size: 1.5rem;
      transition: transform 0.3s;
    }
    .custom-faq-{{ ai_gen_id }} details[open] summary::after {
      content: '−';
    }
    .custom-faq-{{ ai_gen_id }} .faq-answer {
      padding: 12px 0 4px;
      color: rgba(var(--color-foreground), 0.75);
      line-height: 1.6;
    }
  </style>

  {%- if section.settings.title != blank -%}
    <h2 class="faq-title">{{ section.settings.title }}</h2>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'faq_item' -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="faq-answer">{{ block.settings.answer }}</div>
      </details>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns within 30 days of purchase.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}